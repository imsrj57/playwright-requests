# Copy to `.env` (git-ignored) and fill in values for your environment.
# In CI, set these as pipeline secrets instead of using a file.

# ---- API ----
API_BASE_URL=
# none | bearer | basic | api_key | oauth_client_credentials
API_AUTH_TYPE=none
API_TOKEN_URL=
API_CLIENT_ID=
API_CLIENT_SECRET=
API_USERNAME=
API_PASSWORD=
API_TOKEN=
API_KEY_HEADER=x-api-key
API_KEY=

# ---- UI ----
UI_BASE_URL=
UI_USERNAME=
UI_PASSWORD=
UI_ADMIN_USERNAME=
UI_ADMIN_PASSWORD=

# ---- DB (optional, SQL Server via pyodbc) ----
DB_SERVER=
DB_NAME=
DB_USER=
DB_PASSWORD=
